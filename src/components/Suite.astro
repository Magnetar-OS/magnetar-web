---
import { apps, underneath, GITHUB } from '../data/suite';
---

<section class="suite" id="suite" aria-labelledby="suite-title">
  <p class="label">The magnetosphere</p>
  <h2 id="suite-title" class="section-title">Applications that exist nowhere else</h2>
  <p class="lede">
    Each one is held to the best app in its category, feature for feature. Point at one and its line
    lights up in the field.
  </p>

  <ul class="apps">
    {apps.map((app, i) => (
      <li data-tube={i} style={`--hue: ${app.hue}`}>
        <a href={`${GITHUB}/${app.slug}`} rel="external">
          <img src={`/icons/${app.slug}.svg`} alt="" width="56" height="56" loading="lazy" />
          <span class="name">
            {app.name}
            <span class="label">{app.category}</span>
          </span>
          <span class="summary">{app.summary}</span>
          <span class="bench">
            {app.benchmark ? (
              <>
                <span class="label">Parity with</span>
                {app.benchmark}
              </>
            ) : null}
          </span>
        </a>
      </li>
    ))}
  </ul>

  <h3 class="under-title">Underneath and alongside</h3>
  <ul class="under">
    {underneath.map((item) => (
      <li>
        <a href={`${GITHUB}/${item.repo}`} rel="external">{item.name}</a>
        <p>{item.role}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .suite {
    position: relative;
    z-index: 1;
    padding: clamp(4rem, 10vw, 8rem) var(--gutter);
    background: rgb(4 6 12 / 0.88);
  }

  /* Leave the parked star visible beside the list, so a lit tube can be seen. */
  @media (min-width: 900px) {
    .suite {
      /* Matches the section above at the seam, then opens up. */
      background: linear-gradient(180deg, rgb(4 6 12 / 0.88), rgb(4 6 12 / 0) 14rem);
    }

    .suite::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(90deg, rgb(4 6 12 / 0.9) 0 58%, rgb(4 6 12 / 0.2) 82%);
      mask-image: linear-gradient(180deg, transparent, #000 14rem);
    }
  }

  .apps {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    max-width: 62rem;
    border-top: 1px solid var(--rule);
  }

  .apps li {
    border-bottom: 1px solid var(--rule);
  }

  .apps a {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 11rem minmax(0, 1fr) 13rem;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 0.75rem 1rem 0;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.25s;
  }

  /* The app's hue runs in from the left edge like a field line meeting the row. */
  .apps a::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--gutter));
    top: 50%;
    width: calc(var(--gutter) - 0.5rem);
    height: 1px;
    background: var(--hue);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.1, 1);
  }

  .apps a:hover,
  .apps a:focus-visible {
    background: linear-gradient(90deg, color-mix(in oklab, var(--hue) 14%, transparent), transparent 70%);
  }

  .apps a:hover::before,
  .apps a:focus-visible::before {
    transform: scaleX(1);
  }

  .apps img {
    width: 3.5rem;
    height: 3.5rem;
  }

  .name {
    font-family: var(--display);
    font-stretch: 140%;
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.1;
  }

  .name .label,
  .bench .label {
    display: block;
    margin-top: 0.25rem;
  }

  .bench .label {
    margin: 0 0 0.2rem;
  }

  .summary {
    color: var(--dim);
  }

  .bench {
    font-size: 0.92rem;
  }

  .under-title {
    margin: 4.5rem 0 0;
    font-family: var(--display);
    font-stretch: 140%;
    font-weight: 400;
    font-size: 1.25rem;
  }

  .under {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    max-width: 62rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.5rem 2rem;
  }

  .under li {
    padding-top: 0.8rem;
    border-top: 1px solid var(--rule);
  }

  .under a {
    font-family: var(--mono);
    font-stretch: 85%;
    font-size: 0.9rem;
  }

  .under p {
    margin: 0.4rem 0 0;
    color: var(--dim);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .apps a {
      grid-template-columns: 3rem minmax(0, 1fr);
      grid-template-areas: 'icon name' 'icon summary' 'icon bench';
      gap: 0.3rem 1rem;
      align-items: start;
    }

    .apps img {
      grid-area: icon;
      width: 3rem;
      height: 3rem;
    }

    .name {
      grid-area: name;
    }

    .summary {
      grid-area: summary;
    }

    .bench {
      grid-area: bench;
    }

    .bench .label {
      display: inline;
      margin-right: 0.5rem;
    }
  }
</style>
